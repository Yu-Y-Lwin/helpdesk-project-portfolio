    {
      "name": "US-05 Get ticket",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "91be820d-963c-43ca-b9ba-b1ab882b9414",
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns the same ticket', function () {",
              "  pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get('ticketId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}"
          ]
        }
      },
      "response": []
    },
