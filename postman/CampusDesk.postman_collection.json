  "item": [
    {
      "name": "US-01 Create ticket",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "e574e2b5-a4b7-4928-882f-b5cf160db742",
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "const ticket = pm.response.json();",
              "pm.collectionVariables.set('ticketId', ticket.id);",
              "pm.test('Status is open and SLA is 4 hours', function () {",
              "  pm.expect(ticket.status).to.eql('open');",
              "  pm.expect(ticket.sla_hours).to.eql(4);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Laptop will not start\",\n  \"description\": \"The laptop shows a black screen after the logo.\",\n  \"priority\": \"high\",\n  \"requester_email\": \"employee@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
